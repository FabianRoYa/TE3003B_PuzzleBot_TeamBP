<?xml  version="1.0" ?>
<sdf version="1.5">

    <model name='chess'>
        <pose>0 0 0 0 0 0</pose>
        <static>true</static>
        <link name='link'>
            <visual name='box_visual'>
                <cast_shadows>0</cast_shadows>
                    <geometry>
                        <box>
                            <size>0.001 0.3 0.3</size>
                        </box>
                    </geometry>
                <material>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                    <specular>1 1 1 1</specular>
                    <emissive>0.6 0.6 0.6 1</emissive>
                </material>
            </visual>

            <visual name='chess_v'>
                <cast_shadows>0</cast_shadows>
                <pose>0.00065 0.0 0.0 1.5708 0.0 1.5708</pose>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>0.27 0.18</size>
                    </plane>
                </geometry>
                <material>
                    <pbr>
                        <metal>
                            <albedo_map>model://chess/materials/textures/chess.png</albedo_map>
                            <metalness>0.01</metalness>
                            <roughness>0.99</roughness>
                        </metal>
                    </pbr>
                    <ambient>1 1 1 1</ambient>
                    <diffuse>1 1 1 1</diffuse>
                    <specular>1 1 1 1</specular>
                    <shininess> 1 </shininess>
                    <emissive>0.0 0.0 0.0 0.1</emissive>
                </material>
            </visual>

        </link>
    </model>
</sdf>
